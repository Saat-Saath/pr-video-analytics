# Copy this file to .env and fill in your own keys. Never commit .env.
BRIGHTDATA_API_KEY=your_bright_data_api_key
APIFY_TOKEN=your_apify_api_token
# Google Sheet IDs (the long id in each sheet's URL)
SHEET_KALPANA=kalpana_sheet_id
SHEET_SANJAY=sanjay_form_responses_sheet_id
SHEET_INTERNAL_PR=influencer_daily_posting_record_sheet_id
# Apify backup for Facebook view counts Bright Data cannot get (on/off, max reels scanned per day)
APIFY_FB_BACKUP=on
APIFY_FB_BACKUP_MAX_ITEMS=300
# Re-fetch every video's all-time counts every N days (0 = off)
ALL_TIME_REFRESH_DAYS=7
# Facebook view backup only for reels up to N days old (older ones cost ~10x more to scan)
APIFY_FB_BACKUP_MAX_AGE=10
# "PR Video Costs" sheet for cost per view (Source, Account, Month, Amount, Basis)
SHEET_COSTS=costs_sheet_id
SHEET_COSTS_GID=0
# Show cost per view on the public GitHub page too (on/off)
COSTS_PUBLIC=off
